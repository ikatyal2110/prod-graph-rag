# Neo4j Connection Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DB=neo4j

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Retrieval Defaults
DEFAULT_MAX_HOPS=2
DEFAULT_MAX_PATHS=300
DEFAULT_MAX_FACTS=120
DEFAULT_MAX_ANCHORS=15

# Neo4j Schema Configuration
# Relationship mode: "typed" (relationship labels like :AFFECTS) or "property" (single :RELATIONSHIP label with r.type property)
RELATIONSHIP_MODE=property
